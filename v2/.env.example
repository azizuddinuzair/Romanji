# Romanji v2 settings. Copy this file to .env (PowerShell: Copy-Item .env.example .env) and edit .env.
# .env is gitignored and holds secrets. Never commit it. Add every new setting here in the same change.

# Genius API token. Required only for `genius` mode (get one at https://genius.com/api-clients).
GENIUS_ACCESS_TOKEN=

# Whisper model size: tiny | base | small | medium | large (bigger = slower, more accurate; medium suggested for songs).
WHISPER_MODEL=small

# Device Whisper runs on: auto | cpu | cuda.
WHISPER_DEVICE=auto

# Force one language for every line: ja | ko | ar | sr. Blank = auto-detect per line.
DEFAULT_LANGUAGE=

# Japanese romanization system: hepburn | kunrei | passport.
JAPANESE_ROMANIZATION=hepburn

# Folder for saved .txt / .lrc output (a relative path resolves against v2/).
OUTPUT_DIR=output

# Full path to ffmpeg.exe or its folder. Blank = use PATH. Only needed for audio mode.
FFMPEG_PATH=

# Display-column width of the left column in side-by-side output (v1 used 75).
ALIGN_WIDTH=75

# Minimum langdetect probability for a language to count (v1 used 0.25).
LANG_CONFIDENCE=0.25
